# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc & office locks
.DS_Store
*.pem
~$*
*.tmp

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch, reports & snapshots
/scratch/
/reports/
/.snapshots/
/riset/
/source/
.claude
/.agents/

# database backups
/backups/

# one-off / scratch scripts
check_*.ts
inspect_*.ts
migrate_*.ts

# local utility & deployment scripts
deploy_remote.py
/scripts/
/src/scripts/

# internal documentation & strategy markdown files
AGENTS.md
CLAUDE.md
docker.README.md
APP_INTEGRATION_AND_FUNCTIONS.md
INVENTORY_VALUATION.md
IT_GOVERNANCE_PLAN.md
MIGRATION_LOG.md
PROJECT_PLAN.md
STRATEGI_PRESENTASI_BVLGARI.md
/docs/

# Excel files & data exports (preserve production templates)
*.xlsx
!/templates/*.xlsx
!/public/templates/*.xlsx
